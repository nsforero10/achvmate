# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=achvmate_db
DATABASE_URL="postgresql://your_db_user:your_db_password@localhost:5433/achvmate_db"

# ─────────────────────────────────────────────
# Auth.js / NextAuth  (shared between web & api)
# Generate with: openssl rand -base64 32
# ─────────────────────────────────────────────
AUTH_SECRET="your-super-secret-at-least-32-chars-long"

# NestJS reads this same secret to verify Bearer tokens
JWT_SECRET="your-super-secret-at-least-32-chars-long"

# URL of the Next.js app (used by Auth.js for redirects & callbacks)
NEXTAUTH_URL="http://localhost:3002"

# ─────────────────────────────────────────────
# OAuth — GitHub
# Create at: https://github.com/settings/developers
# Callback URL: http://localhost:3002/api/auth/callback/github
# ─────────────────────────────────────────────
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"

# ─────────────────────────────────────────────
# OAuth — Google
# Create at: https://console.cloud.google.com/apis/credentials
# Callback URL: http://localhost:3002/api/auth/callback/google
# ─────────────────────────────────────────────
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# ─────────────────────────────────────────────
# Magic Links — Resend
# Get key at: https://resend.com/api-keys
# ─────────────────────────────────────────────
AUTH_RESEND_KEY="re_your_resend_api_key"
AUTH_EMAIL_FROM="no-reply@achvmate.app"

# ─────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3000"
